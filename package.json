{
  "name": "myacademy-portal",
  "version": "1.0.0",
  "description": "MyAcademy Portal Workspace",
  "scripts": {
    "install:all": "npm ci --prefix client && npm ci --prefix server",
    "seed": "npm run seed --prefix server",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "test": "npm test --prefix server",
    "lint": "npm run lint --prefix client",
    "assets": "node node_modules/svgo/bin/svgo.js client/src/assets/logo.svg --multipass && node scripts/generate-icons.cjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "svgo": "^4.1.0"
  }
}
