NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/myacademy_development

# Generate independently. Never commit real values. JWT_SECRET: at least 32 random bytes.
JWT_SECRET=
# Base64 encoding of exactly 32 random bytes. Required in production; keep stable and backed up.
WHATSAPP_AUTH_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional exact comma-separated origins. Production accepts HTTPS origins only.
# CORS_ORIGINS=https://myacademyportal.online,https://www.myacademyportal.online
# Set only to the actual trusted proxy/network. Example for exactly one protected proxy hop:
# TRUST_PROXY=1

# Demo seeding is blocked in production and requires opt-in elsewhere.
# ALLOW_DEMO_SEED=true
# SEED_ADMIN_PASSWORD=
# SEED_TEACHER_PASSWORD=
# SEED_STUDENT_PASSWORD=

# The verified production Cloudinary environment uses dynamic folders.
CLOUDINARY_FOLDER_MODE=dynamic
# Optional: serve client/dist from Express after npm run build (same-origin deployment).
# SERVE_CLIENT=true
